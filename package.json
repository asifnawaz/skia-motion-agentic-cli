{
  "name": "skia-motion-agentic-cli",
  "version": "3.5.0",
  "description": "A JSON-only CLI for interactive motion assets with React Native Skia v3 and offline Remotion video.",
  "type": "module",
  "bin": {
    "skac": "bin/skac.js",
    "skia-motion-agentic-cli": "bin/skac.js"
  },
  "files": [
    "bin",
    "src",
    "runtime",
    "docs",
    "!docs/media",
    "!docs/examples",
    "templates",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-reanimated": ">=4",
    "react-native-skia": ">=3.0.0",
    "react-native-worklets": ">=0.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-skia": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "scripts": {
    "docs:rules": "node scripts/rules-doc.js",
    "unicode:tables": "node scripts/unicode-tables.js",
    "pack:runtime": "node scripts/pack-runtime.js",
    "readme:media": "node scripts/readme-media.js",
    "test": "node --test test/unit/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "typecheck:runtime": "node scripts/typecheck-runtime.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asifnawaz/skia-motion-agentic-cli.git"
  },
  "bugs": {
    "url": "https://github.com/asifnawaz/skia-motion-agentic-cli/issues"
  },
  "homepage": "https://github.com/asifnawaz/skia-motion-agentic-cli",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "skia",
    "react-native-skia",
    "remotion",
    "animation",
    "motion",
    "motion-design",
    "character-animation",
    "cli",
    "ai-agents",
    "claude-code",
    "agentic-coding",
    "video"
  ],
  "license": "MIT",
  "dependencies": {
    "canvaskit-wasm": "0.41.1",
    "esbuild": "0.28.1",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "react-native-worklets": "0.13.0",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  }
}
