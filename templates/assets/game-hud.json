          {"from": "idle", "to": "reloading", "when": [["reload"]]},
          {"from": "reloading", "to": "reloading", "when": [["reload"]]},
          {"from": "ready", "to": "reloading", "when": [["reload"]]},
          {"from": "reloading", "to": "ready", "exit_at": 1},
          {"from": "ready", "to": "idle", "exit_at": 1}
        ]
      }
    ]
